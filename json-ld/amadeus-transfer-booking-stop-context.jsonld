{
  "@context": {
    "@version": 1.1,
    "amadeus": "https://amadeus.com/schema/",
    "schema": "https://schema.org/",
    "dcterms": "http://purl.org/dc/terms/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "StopOver": "amadeus:StopOver",
    "duration": {
      "@id": "amadeus:duration",
      "@type": "xsd:string"
    },
    "sequenceNumber": {
      "@id": "amadeus:sequenceNumber",
      "@type": "xsd:decimal"
    },
    "location": {
      "@id": "amadeus:location",
      "@type": "xsd:string"
    }
  }
}