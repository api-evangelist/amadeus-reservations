{
  "@context": {
    "@version": 1.1,
    "amadeus": "https://amadeus.com/schema/",
    "schema": "https://schema.org/",
    "dcterms": "http://purl.org/dc/terms/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "Name": "amadeus:Name",
    "type": {
      "@id": "amadeus:type",
      "@type": "xsd:string"
    },
    "firstName": {
      "@id": "amadeus:firstName",
      "@type": "xsd:string"
    },
    "lastName": {
      "@id": "amadeus:lastName",
      "@type": "xsd:string"
    },
    "title": {
      "@id": "amadeus:title",
      "@type": "xsd:string"
    }
  }
}