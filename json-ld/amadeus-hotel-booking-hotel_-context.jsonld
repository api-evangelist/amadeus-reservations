{
  "@context": {
    "@version": 1.1,
    "amadeus": "https://amadeus.com/schema/",
    "schema": "https://schema.org/",
    "dcterms": "http://purl.org/dc/terms/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "Hotel_Contact": "amadeus:Hotel_Contact",
    "phone": {
      "@id": "amadeus:phone",
      "@type": "xsd:string"
    },
    "fax": {
      "@id": "amadeus:fax",
      "@type": "xsd:string"
    },
    "email": "schema:email"
  }
}