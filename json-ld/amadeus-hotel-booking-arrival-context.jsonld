{
  "@context": {
    "@version": 1.1,
    "amadeus": "https://amadeus.com/schema/",
    "schema": "https://schema.org/",
    "dcterms": "http://purl.org/dc/terms/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "ArrivalFlightDetails": "amadeus:ArrivalFlightDetails",
    "carrierCode": {
      "@id": "amadeus:carrierCode",
      "@type": "xsd:string"
    },
    "number": {
      "@id": "amadeus:number",
      "@type": "xsd:string"
    },
    "departure": {
      "@id": "amadeus:departure",
      "@type": "@id"
    },
    "arrival": {
      "@id": "amadeus:arrival",
      "@type": "@id"
    }
  }
}