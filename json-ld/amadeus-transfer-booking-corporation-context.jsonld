{
  "@context": {
    "@version": 1.1,
    "amadeus": "https://amadeus.com/schema/",
    "schema": "https://schema.org/",
    "dcterms": "http://purl.org/dc/terms/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "Corporation": "amadeus:Corporation",
    "address": {
      "@id": "amadeus:address",
      "@type": "xsd:string"
    },
    "info": {
      "@id": "amadeus:info",
      "@type": "@id"
    }
  }
}