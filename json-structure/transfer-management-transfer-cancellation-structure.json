{
  "$schema": "https://json-structure.org/meta/core/v0/#",
  "$id": "https://raw.githubusercontent.com/api-evangelist/amadeus-reservations/refs/heads/main/json-structure/transfer-management-transfer-cancellation-structure.json",
  "name": "TransferCancellation",
  "description": "information returned in cancelation response",
  "type": "object",
  "properties": {
    "confirmNbr": {
      "type": "string",
      "description": "transfer identifier - confirmation number from service provider that identifies the ride"
    },
    "reservationStatus": {
      "type": "string",
      "enum": [
        "CANCELLED",
        "CONFIRMED"
      ],
      "description": "status of reservation"
    }
  }
}